From 085b3eb2f0c93f867516d6e0973a3b33e9e5505b Mon Sep 17 00:00:00 2001
From: "JB (via Claude)" <jbtanon@gmail.com>
Date: Mon, 17 Aug 2026 01:19:48 +0000
Subject: [PATCH] fix: add missing admin auth check to order label printing
 page
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

app/admin/orders/[id]/labels/page.tsx queried booking and order_bags data
directly with no auth check at all — reachable by anyone who knew or
guessed a booking id, logged in or not. Every other page under app/admin
gates on isAdminForCurrentLocation(); this one was simply missing it.

Adds the same non-throwing check + redirect("/admin/login") pattern used
in the crash fix for app/admin/page.tsx and friends.
---
 app/admin/orders/[id]/labels/page.tsx | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/app/admin/orders/[id]/labels/page.tsx b/app/admin/orders/[id]/labels/page.tsx
index c46814c..8f562ac 100644
--- a/app/admin/orders/[id]/labels/page.tsx
+++ b/app/admin/orders/[id]/labels/page.tsx
@@ -1,7 +1,14 @@
 import { createAdminClient } from "@/lib/supabase/admin"
-import { notFound } from "next/navigation"
+import { notFound, redirect } from "next/navigation"
+import { isAdminForCurrentLocation } from "@/lib/auth-guard"
 
 export default async function PrintLabelsPage({ params }: { params: Promise<{ id: string }> }) {
+  // Unlike every other /admin/** page, this one queried booking/order data
+  // directly with no admin check at all — reachable by anyone who knew or
+  // guessed a booking id, logged in or not. Add the same guard used
+  // everywhere else instead of leaving it open.
+  if (!(await isAdminForCurrentLocation())) redirect("/admin/login")
+
   const { id } = await params
   const supabase = createAdminClient()
 
